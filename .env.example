# Tierscape runs with none of these set. Each one switches a feature from
# "not configured" to live. Keep real keys in .env.local (never commit it).

# Aerial imagery. Pick one provider. Confirm the license allows tracing and
# measuring before going live. Google imagery is NOT allowed for this.
IMAGERY_PROVIDER=esri          # esri | nearmap
ARCGIS_API_KEY=                # ArcGIS Location Platform key: Esri World Imagery tiles and address suggestions
                               # (enable the basemaps and geocoding privileges on the key)
NEARMAP_API_KEY=               # Nearmap key, sharper imagery built for contractor measuring

# Parcel lines outside Arizona (Arizona uses the free statewide AZGeo layer).
REGRID_API_TOKEN=

# Claude: drafts the three options from a yard photo, plant growth estimates,
# finding where a site photo was taken. Needs a Claude Platform API key with
# billing; a Claude.ai subscription does not include API access.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=               # defaults to claude-opus-5-5
# AI text calls are capped per company per UTC day: 40 on paid plans, 10 in the trial (src/lib/billing/core.ts).

# Concept pictures from the client's photo (OpenAI image edits).
RENDER_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=            # defaults to gpt-image-2.6-sunburst; gpt-image-1 was shut down on 2026-10-23

# 811 locate requests. Leave empty to prepare tickets for manual submission.
# A direct integration needs an agreement with the one call center.
ONECALL_PROVIDER=              # empty | exactix
ONECALL_API_URL=
ONECALL_API_KEY=

# Accounts (Supabase). Billing cannot attach to anything until sign in is live.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # server only, never in the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe Billing. Sandbox keys only (sk_test_ or rk_test_) until the flow is reviewed.
STRIPE_SECRET_KEY=             # a restricted key is best: Checkout, Customers, Subscriptions, Invoices, Billing Portal
STRIPE_WEBHOOK_SECRET=         # whsec_ for the /api/billing/webhook endpoint
STRIPE_PRICE_STARTER_MONTHLY=  # one Product per plan, a monthly and an annual Price under each
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_FOUNDING_COUPON=        # $50 off, repeating, 12 months, for monthly Pro only
STRIPE_AUTOMATIC_TAX=           # 1 once Stripe Tax is set up; Checkout then calculates and shows tax

# Client payments to the contractor through Stripe Connect (direct charges on
# the contractor's own Accounts v2 account). Uses STRIPE_SECRET_KEY above.
# Separate from Tierscape's own subscription billing.
STRIPE_CONNECT_WEBHOOK_SECRET= # whsec_ for /api/payments/webhook, an endpoint listening to events on connected accounts
STRIPE_CONNECT_API_VERSION=    # defaults to 2026-11-18.endive (Accounts v2 calls)

# Tierscape platform fee on client payments. OFF by default. No rate has been
# chosen: leave these empty. A fee is never taken in live mode unless
# PLATFORM_FEE_ALLOW_LIVE=1, and it is never added to what the client pays.
PLATFORM_FEE_ENABLED=
PLATFORM_FEE_BPS=              # basis points, 100 = 1%, capped at 1000
PLATFORM_FEE_FIXED_CENTS=
PLATFORM_FEE_ALLOW_LIVE=
